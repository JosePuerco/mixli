{
  "name": "Mixli – Stil B „Weich & ruhig“",
  "mode": "light",
  "color": {
    "background": "#F4F3EF",
    "surface": "#FFFFFF",
    "surfaceMuted": "#F4F3EF",
    "text": "#1C1C1A",
    "textMuted": "#6A6964",
    "textPlaceholder": "#A3A099",
    "divider": "#EDEBE5",
    "border": "#DAD7CF",
    "borderDashed": "#A8A59B",
    "accent": "#3F5A2E",
    "accentHover": "#2C4120",
    "onAccent": "#FFFFFF",
    "nav": "#1C1C1A",
    "navIcon": "#BDBAB0",
    "overlay": "rgba(28, 28, 26, 0.35)",
    "warningBg": "#F3E6CF",
    "warningDot": "#B5865A",
    "successBg": "#E4EADC",
    "segments": ["#3F5A2E", "#A7B88F", "#C9A97A", "#5E5B52", "#D8C3A0", "#8A9A7B", "#B5865A"],
    "photoPlaceholders": ["#E8E4D8", "#E4E8DC", "#EDE5D6", "#E6E2DA", "#ECE6D9", "#F0EEE8", "#E3DCD3"]
  },
  "font": {
    "family": "Manrope",
    "fallback": "system-ui, sans-serif",
    "weights": [400, 500, 600, 700, 800],
    "numbers": "tabular-nums"
  },
  "type": {
    "display": { "size": 56, "weight": 800, "use": "Große Zahl im Mengen-Sheet" },
    "h1": { "size": 26, "weight": 700, "letterSpacing": "-0.01em", "use": "Screen-Titel" },
    "h1Detail": { "size": 28, "weight": 800, "use": "Titel Müsli-Detail" },
    "h2": { "size": 20, "weight": 700, "use": "Sheet-Titel" },
    "statLarge": { "size": 28, "weight": 800, "use": "kcal im Mixen-Screen" },
    "body": { "size": 15, "weight": 600 },
    "bodyLarge": { "size": 16, "weight": 600 },
    "label": { "size": 13, "weight": 700, "use": "Chips, Abschnittslabels" },
    "caption": { "size": 12, "weight": 500 }
  },
  "radius": {
    "card": 24,
    "photo": 18,
    "sheet": 28,
    "keypadKey": 18,
    "input": 22,
    "pill": 9999
  },
  "space": {
    "screenPadding": 16,
    "gapSmall": 8,
    "gap": 12,
    "gapLarge": 16,
    "topSafe": 56,
    "touchTarget": 44,
    "primaryButtonHeight": 56
  },
  "nav": {
    "height": 64,
    "radius": 32,
    "insetX": 16,
    "insetBottom": 24,
    "activePill": "Hintergrund background, Text text, Icon + Label",
    "inactive": "nur Icon in navIcon"
  },
  "shadow": {
    "fab": "0 6px 18px rgba(28, 28, 26, 0.18)",
    "labelPreview": "0 4px 14px rgba(28, 28, 26, 0.12)"
  },
  "motion": {
    "easeOut": "cubic-bezier(.2, .8, .2, 1)",
    "spring": "cubic-bezier(.2, .9, .3, 1.2)",
    "springStrong": "cubic-bezier(.2, .9, .3, 1.3)",
    "cardIn": { "durationMs": 450, "staggerMs": 70, "from": "scale(.85) translateY(12px), opacity 0" },
    "numberCount": { "durationMs": 480, "easing": "easeOutCubic" },
    "ringSegments": { "durationMs": 550 },
    "sheetIn": { "durationMs": 420, "from": "translateY(100%)" },
    "overlayIn": { "durationMs": 250 },
    "chipIn": { "durationMs": 350, "overshoot": 1.08 },
    "stepIn": { "durationMs": 380, "from": "translateX(28px), opacity 0" },
    "screenFade": { "durationMs": 200 },
    "press": { "scale": 0.92, "durationMs": 150 },
    "reducedMotion": "Alle Animationen aus"
  }
}
